{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter Web (Chrome)",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "env": {
        "CHROME_EXECUTABLE": "/usr/bin/chromium"
      },
      "program": "frontend/lib/main.dart"
    },
    {
      "name": "Flutter Web (Release)",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "flutterMode": "release",
      "env": {
        "CHROME_EXECUTABLE": "/usr/bin/chromium"
      },
      "program": "frontend/lib/main.dart"
    }
  ]
}
